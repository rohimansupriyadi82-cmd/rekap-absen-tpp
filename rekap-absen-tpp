<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Absensi Premium</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- SheetJS for Excel Import/Export -->
    <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

    <style>
        :root {
            /* Color Palette - TEMA "ADEM" (Teal/Ocean Sage) */
            --bg-main: #f0fdfa;        
            --sidebar-bg: #134e4a;     
            --sidebar-surface: #0f766e;
            --sidebar-text: #ccfbf1;   
            --primary: #0ea5e9;        
            --primary-hover: #0284c7;
            --success: #10b981;        
            --success-hover: #059669;
            --warning: #f59e0b;
            --warning-hover: #d97706;
            --danger: #ef4444;
            --card-bg: #ffffff;
            --text-main: #334155;      
            --text-muted: #64748b;
            --border: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ------------------ SIDEBAR STYLES ------------------ */
        .sidebar {
            width: 360px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-text);
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,0.1);
            box-shadow: 4px 0 20px rgba(15, 118, 110, 0.15);
            z-index: 10;
        }

        .sidebar-header {
            padding: 24px;
            background: linear-gradient(135deg, #0f766e, #134e4a);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-header img {
            width: 34px;
            height: auto;
            object-fit: contain;
        }

        .sidebar-header h2 {
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #ffffff;
        }

        .sidebar-content {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
        }

        .sidebar-content::-webkit-scrollbar { width: 6px; }
        .sidebar-content::-webkit-scrollbar-track { background: var(--sidebar-bg); }
        .sidebar-content::-webkit-scrollbar-thumb { background: #0f766e; border-radius: 4px; }

        .section-title {
            font-size: 12px;
            text-transform: uppercase;
            color: #99f6e4;
            font-weight: 700;
            letter-spacing: 1px;
            margin: 24px 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; font-size: 13px; margin-bottom: 6px; color: #ccfbf1; }
        .flex-row { display: flex; gap: 10px; }

        input, select {
            width: 100%;
            background-color: var(--sidebar-surface);
            border: 1px solid rgba(255,255,255,0.15);
            color: white;
            padding: 10px 12px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 13px;
            transition: all 0.2s;
        }
        
        input::placeholder { color: #99f6e4; opacity: 0.6; }
        input:focus, select:focus { outline: none; border-color: #67e8f9; box-shadow: 0 0 0 3px rgba(103, 232, 249, 0.2); }

        .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .checkbox-label {
            display: flex; align-items: center; gap: 8px; font-size: 13px;
            cursor: pointer; background: var(--sidebar-surface); padding: 8px 12px;
            border-radius: 6px; border: 1px solid rgba(255,255,255,0.05); transition: 0.2s;
        }
        .checkbox-label:hover { border-color: rgba(255,255,255,0.3); }
        .checkbox-label input { width: auto; accent-color: #0ea5e9; }

        button {
            width: 100%; padding: 12px; background-color: var(--primary); color: white;
            border: none; border-radius: 8px; font-weight: 600; font-family: inherit;
            cursor: pointer; transition: 0.3s; display: flex; justify-content: center;
            align-items: center; gap: 8px; margin-top: 10px;
        }

        button:hover { background-color: var(--primary-hover); transform: translateY(-1px); }
        .btn-success { background-color: var(--success); }
        .btn-success:hover { background-color: var(--success-hover); }
        .btn-warning { background-color: var(--warning); color: #0f172a; }
        .btn-warning:hover { background-color: var(--warning-hover); }
        .btn-outline { background-color: transparent; border: 1px solid rgba(255,255,255,0.3); color: #ffffff; }
        .btn-outline:hover { background-color: rgba(255,255,255,0.1); }

        .employee-list {
            list-style: none; margin-top: 10px; max-height: 250px; 
            overflow-y: auto; padding-right: 5px;
        }
        .employee-list::-webkit-scrollbar { width: 5px; }
        .employee-list::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 4px; }
        .employee-list::-webkit-scrollbar-thumb { background: #5eead4; border-radius: 4px; }

        .employee-item {
            background: var(--sidebar-surface); padding: 10px 12px; border-radius: 8px;
            margin-bottom: 8px; display: flex; justify-content: space-between;
            align-items: center; border: 1px solid rgba(255,255,255,0.05);
        }
        .employee-info { display: flex; flex-direction: column; }
        .employee-info .name { font-size: 13px; font-weight: 600; color: white; }
        .employee-info .time { font-size: 11px; color: #99f6e4; }
        .btn-delete {
            background: rgba(239, 68, 68, 0.15); color: #fca5a5; width: 28px;
            height: 28px; padding: 0; border-radius: 6px; margin: 0;
        }
        .btn-delete:hover { background: var(--danger); color: white; }
        input[type="file"] { display: none; }

        /* ------------------ MAIN CONTENT (TABLE) ------------------ */
        .main-content {
            flex: 1; padding: 30px; overflow-y: auto;
            display: flex; flex-direction: column; align-items: center;
        }
        .document-container {
            background: var(--card-bg); width: 100%; max-width: 1400px;
            padding: 40px; border-radius: 16px;
            box-shadow: 0 10px 35px rgba(15, 118, 110, 0.08), 0 1px 5px rgba(15, 118, 110, 0.03);
            position: relative; /* Added for copyright positioning */
        }
        .doc-header { text-align: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 2px solid var(--border); }
        .doc-header h1 { font-size: 24px; color: #134e4a; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; }
        .doc-header p { font-size: 14px; color: var(--text-muted); font-weight: 500; }
        
        .table-responsive { overflow-x: auto; border-radius: 10px; border: 1px solid var(--border); }
        table { width: 100%; border-collapse: collapse; white-space: nowrap; }
        th, td { border: 1px solid var(--border); padding: 10px 12px; text-align: center; font-size: 13px; }
        th { background-color: #f0fdfa; color: #0f766e; font-weight: 700; text-transform: uppercase; font-size: 12px; }
        thead tr:first-child th { background: linear-gradient(to right, #0f766e, #115e59); color: white; border-color: #134e4a; }
        td:nth-child(2) { text-align: left; font-weight: 600; color: #1e293b; }
        tbody tr:hover td { background-color: #f8fafc; }
        tbody tr:nth-child(even) { background-color: #fdfdfd; }

        .signature-section { margin-top: 40px; display: flex; justify-content: flex-end; padding-right: 40px; }
        .signature-box { text-align: left; width: 280px; }
        .signature-box p { margin: 0 0 5px 0; font-size: 14px; color: #334155; }
        .signature-box .sign-space { height: 90px; }
        .signature-box .name { font-weight: 700; text-decoration: underline; color: #0f172a; font-size: 15px; }
        .signature-box .nip { font-size: 13px; color: var(--text-muted); }

        /* Copyright Styles */
        .copyright {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        /* ------------------ PRINT STYLES (F4 Landscape - SANGAT PRESISI) ------------------ */
        @media print {
            @page {
                size: 330mm 215mm; /* Ukuran presisi F4 Landscape */
                margin: 10mm 12mm 10mm 12mm;
            }

            body { background-color: white; display: block; }
            .sidebar { display: none !important; }
            .main-content { padding: 0; display: block; }
            .document-container { box-shadow: none; border-radius: 0; padding: 0; width: 100%; max-width: none; }
            .table-responsive { border: none; overflow: visible; }
            
            table {
                width: 100%;
                table-layout: auto !important; 
            }

            th, td {
                border: 1px solid #000 !important;
                padding: 4px 5px !important;
                font-size: 8.5pt !important;
                height: 22px !important;
                white-space: nowrap !important;
            }
            
            th { background-color: #e2e8f0 !important; color: black !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            thead tr:first-child th { background: #cbd5e1 !important; color: black !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            
            .doc-header { margin-bottom: 15px !important; padding-bottom: 5px !important; }
            .doc-header h1 { font-size: 15pt !important; margin-bottom: 2px !important;}
            .doc-header p { font-size: 11pt !important; }

            .signature-section { margin-top: 15px !important; padding-right: 20px !important; }
            .signature-box .sign-space { height: 45px !important; } 
            .signature-box p, .signature-box .name, .signature-box .nip { font-size: 11pt !important; margin-bottom: 2px !important; }

            /* Adjust Copyright for Print */
            .copyright {
                margin-top: 20px !important;
                font-size: 9pt !important;
                padding-top: 10px !important;
                color: #000 !important;
            }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR PENGATURAN -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <img src="https://iili.io/oK4k3Sp.png" alt="Logo Kab Bekasi">
            <h2>Panel Kontrol</h2>
        </div>
        
        <div class="sidebar-content">
            <!-- Aksi Utama: Cetak & Excel -->
            <div class="section-title" style="margin-top: 0;">Aksi Utama</div>
            <button class="btn-success" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Cetak PDF (F4 Landscape)
            </button>
            <div class="flex-row" style="margin-top: 10px;">
                <label for="uploadExcel" class="btn-warning" style="display:flex; justify-content:center; align-items:center; gap:8px; width:100%; padding:12px; border-radius:8px; cursor:pointer; font-weight:600; font-size:13px; text-align:center;">
                    <i class="fa-solid fa-file-import"></i> Impor Excel
                </label>
                <input type="file" id="uploadExcel" accept=".xlsx, .xls" onchange="importExcel(event)">
                
                <button class="btn-outline" onclick="downloadTemplate()" title="Unduh Template Excel">
                    <i class="fa-solid fa-download"></i> Template
                </button>
            </div>

            <!-- Waktu & Tanggal -->
            <div class="section-title">Periode Laporan</div>
            <div class="form-group flex-row">
                <select id="setBulan">
                    <option value="Januari">Januari</option>
                    <option value="Februari">Februari</option>
                    <option value="Maret">Maret</option>
                    <option value="April">April</option>
                    <option value="Mei">Mei</option>
                    <option value="Juni">Juni</option>
                    <option value="Juli">Juli</option>
                    <option value="Agustus">Agustus</option>
                    <option value="September">September</option>
                    <option value="Oktober" selected>Oktober</option>
                    <option value="November">November</option>
                    <option value="Desember">Desember</option>
                </select>
                <input type="number" id="setTahun" value="2026" min="2020">
            </div>
            <div class="form-group">
                <label>Minggu Ke-</label>
                <select id="setMinggu">
                    <option value="1">Minggu 1</option>
                    <option value="2">Minggu 2</option>
                    <option value="3">Minggu 3</option>
                    <option value="4">Minggu 4</option>
                    <option value="5">Minggu 5</option>
                </select>
            </div>

            <!-- Pengaturan Hari -->
            <div class="section-title">Hari Aktif (Kolom)</div>
            <div class="checkbox-grid" id="hariContainer">
                <label class="checkbox-label"><input type="checkbox" value="Senin" checked> Senin</label>
                <label class="checkbox-label"><input type="checkbox" value="Selasa" checked> Selasa</label>
                <label class="checkbox-label"><input type="checkbox" value="Rabu" checked> Rabu</label>
                <label class="checkbox-label"><input type="checkbox" value="Kamis" checked> Kamis</label>
                <label class="checkbox-label"><input type="checkbox" value="Jumat" checked> Jumat</label>
                <label class="checkbox-label"><input type="checkbox" value="Sabtu" checked> Sabtu</label>
            </div>

            <!-- Tanda Tangan -->
            <div class="section-title">Pengesahan (Kepala Sekolah)</div>
            <div class="form-group">
                <input type="text" id="setKepsekNama" value="ROHIMAH, S.Pd" placeholder="Nama Lengkap & Gelar">
            </div>
            <div class="form-group">
                <input type="text" id="setKepsekNIP" value="19680604 200604 2 004" placeholder="NIP">
            </div>

            <!-- Kelola Guru -->
            <div class="section-title">Kelola Pegawai / Guru</div>
            <div class="form-group">
                <input type="text" id="addGuruNama" placeholder="Nama Guru Baru" style="margin-bottom: 10px;">
                <div class="flex-row">
                    <div style="flex:1">
                        <label style="font-size:11px">Datang</label>
                        <input type="time" id="addGuruDatang" value="06:30">
                    </div>
                    <div style="flex:1">
                        <label style="font-size:11px">Pulang</label>
                        <input type="time" id="addGuruPulang" value="14:00">
                    </div>
                </div>
                <button type="button" onclick="tambahGuru()"><i class="fa-solid fa-user-plus"></i> Tambah Pegawai</button>
            </div>

            <!-- Filter Pencarian Khusus Sidebar -->
            <div style="margin-top: 20px; border-top: 1px dashed rgba(255,255,255,0.2); padding-top: 15px;">
                <input type="text" id="searchPegawai" placeholder="🔍 Cari pegawai pada list sidebar..." oninput="renderApp()">
            </div>

            <!-- Daftar Pegawai -->
            <ul class="employee-list" id="daftarGuruPanel">
                <!-- List Guru masuk sini via JS -->
            </ul>
        </div>
    </aside>

    <!-- AREA UTAMA (TABEL) -->
    <main class="main-content">
        <div class="document-container">
            <!-- Header Dokumen -->
            <div class="doc-header">
                <h1>Rekapitulasi Absensi Manual Guru</h1>
                <p>Minggu ke: <span id="displayMinggu">1</span> &nbsp;|&nbsp; Bulan: <span id="displayBulan">Oktober</span> &nbsp;|&nbsp; Tahun: <span id="displayTahun">2026</span></p>
            </div>

            <!-- Tabel Dinamis -->
            <div class="table-responsive">
                <table id="tabelAbsensi">
                    <thead id="tabelHead">
                        <!-- Head di-generate via JS -->
                    </thead>
                    <tbody id="tabelBody">
                        <!-- Body di-generate via JS -->
                    </tbody>
                </table>
            </div>

            <!-- Tanda Tangan -->
            <div class="signature-section">
                <div class="signature-box">
                    <p>Mengetahui,</p>
                    <p>Kepala Sekolah,</p>
                    <div class="sign-space"></div>
                    <p class="name" id="displayKepsekNama">(ROHIMAH, S.Pd)</p>
                    <p class="nip">NIP. <span id="displayKepsekNIP">19680604 200604 2 004</span></p>
                </div>
            </div>

            <!-- Hak Cipta -->
            <div class="copyright">
                &copy; <span id="currentYear">2026</span> Dibuat dan Dikembangkan oleh <strong>Rohiman Khan</strong>. Hak Cipta Dilindungi Undang-Undang.
            </div>
        </div>
    </main>

    <!-- JAVASCRIPT UNTUK REAKTIVITAS UI -->
    <script>
        // Set tahun otomatis pada copyright
        document.getElementById('currentYear').textContent = new Date().getFullYear();

        // --- State Application ---
        let appState = {
            periode: { minggu: '1', bulan: 'Oktober', tahun: '2026' },
            kepsek: { nama: 'ROHIMAH, S.Pd', nip: '19680604 200604 2 004' },
            hariAktif: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'],
            guru: [
                { id: 1, nama: "ROHIMAH, S.Pd", datang: "10:00", pulang: "17:30" },
                { id: 2, nama: "TUTI ALAWIYAH, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 3, nama: "MASTUROH, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 4, nama: "DEDEN NASROLIH, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 5, nama: "IDRIS AFANDI, S.Pd", datang: "10:00", pulang: "17:30" },
                { id: 6, nama: "NENENG PAUJIAH, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 7, nama: "IKA KOMALASARI, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 8, nama: "YUNITA HAYATUN, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 9, nama: "ARIE HIDAYAT, S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 10, nama: "ROHIMAN SUPRIADI, A.Ma.Pd", datang: "06:30", pulang: "14:00" },
                { id: 11, nama: "MURTAFIATUSSARIFAH", datang: "06:30", pulang: "14:00" },
                { id: 12, nama: "MUHAMMAD ANWAR,S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 13, nama: "RIZA BAKHTIAR RIVAI,S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 14, nama: "WINDY TRIASTUTI,S.Pd", datang: "06:30", pulang: "14:00" },
                { id: 15, nama: "RIJAL", datang: "06:30", pulang: "14:00" }
            ]
        };

        // --- Render UI ---
        function renderApp() {
            document.getElementById('displayMinggu').textContent = appState.periode.minggu;
            document.getElementById('displayBulan').textContent = appState.periode.bulan;
            document.getElementById('displayTahun').textContent = appState.periode.tahun;
            document.getElementById('displayKepsekNama').textContent = `(${appState.kepsek.nama})`;
            document.getElementById('displayKepsekNIP').textContent = appState.kepsek.nip;

            const panelList = document.getElementById('daftarGuruPanel');
            const searchInput = document.getElementById('searchPegawai');
            const keyword = searchInput ? searchInput.value.toLowerCase() : '';
            
            panelList.innerHTML = '';
            appState.guru.forEach((g) => {
                if(g.nama.toLowerCase().includes(keyword)) {
                    panelList.innerHTML += `
                        <li class="employee-item">
                            <div class="employee-info">
                                <span class="name">${g.nama}</span>
                                <span class="time"><i class="fa-regular fa-clock"></i> ${g.datang} - ${g.pulang}</span>
                            </div>
                            <button class="btn-delete" onclick="hapusGuru(${g.id})" title="Hapus">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </li>
                    `;
                }
            });

            const tHead = document.getElementById('tabelHead');
            let thHari = '', thSub = '';
            appState.hariAktif.forEach(hari => {
                thHari += `<th colspan="3">${hari}</th>`;
                thSub += `<th>Datang</th><th>Pulang</th><th>TTD</th>`;
            });

            tHead.innerHTML = `
                <tr>
                    <th rowspan="2">No</th>
                    <th rowspan="2">Nama Guru</th>
                    ${thHari}
                </tr>
                <tr>${thSub}</tr>
            `;

            const tBody = document.getElementById('tabelBody');
            tBody.innerHTML = '';
            
            if(appState.guru.length === 0) {
                tBody.innerHTML = `<tr><td colspan="${2 + (appState.hariAktif.length * 3)}">Belum ada data pegawai. Silakan tambah di panel kontrol.</td></tr>`;
                return;
            }

            appState.guru.forEach((g, index) => {
                let tdHari = '';
                appState.hariAktif.forEach(hari => {
                    let formatDatang = g.datang.replace(':', '.');
                    let formatPulang = g.pulang.replace(':', '.');
                    tdHari += `<td>${formatDatang}</td><td>${formatPulang}</td><td></td>`;
                });

                tBody.innerHTML += `
                    <tr>
                        <td>${index + 1}</td>
                        <td>${g.nama}</td>
                        ${tdHari}
                    </tr>
                `;
            });
        }

        // --- Action Functions ---
        function tambahGuru() {
            const nama = document.getElementById('addGuruNama').value;
            const datang = document.getElementById('addGuruDatang').value;
            const pulang = document.getElementById('addGuruPulang').value;

            if(nama.trim() === '') {
                alert('Nama guru tidak boleh kosong!');
                return;
            }

            appState.guru.push({ id: Date.now(), nama: nama, datang: datang, pulang: pulang });
            document.getElementById('addGuruNama').value = ''; 
            renderApp();
        }

        function hapusGuru(id) {
            appState.guru = appState.guru.filter(g => g.id !== id);
            renderApp();
        }

        // --- EXCEL FUNCTIONS ---
        function downloadTemplate() {
            const ws_data = [
                ["Nama Lengkap", "Jam Datang", "Jam Pulang"],
                ["GURU CONTOH 1, S.Pd", "06:30", "14:00"],
                ["GURU CONTOH 2, S.Pd", "10:00", "17:30"]
            ];
            
            const ws = XLSX.utils.aoa_to_sheet(ws_data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "TemplatePegawai");
            XLSX.writeFile(wb, "Template_Import_Guru.xlsx");
        }

        function importExcel(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const json_data = XLSX.utils.sheet_to_json(worksheet, {header: 1});
                
                if(json_data.length > 1) {
                    appState.guru = [];
                    for(let i = 1; i < json_data.length; i++) {
                        const row = json_data[i];
                        if(row.length > 0 && row[0]) {
                            let datangFormat = "06:30";
                            let pulangFormat = "14:00";
                            
                            if(row[1]) datangFormat = formatExcelTime(row[1]);
                            if(row[2]) pulangFormat = formatExcelTime(row[2]);

                            appState.guru.push({
                                id: Date.now() + i,
                                nama: row[0],
                                datang: datangFormat,
                                pulang: pulangFormat
                            });
                        }
                    }
                    renderApp();
                    alert("Data berhasil diimpor!");
                } else {
                    alert("File Excel kosong atau format tidak sesuai.");
                }
                event.target.value = '';
            };
            reader.readAsArrayBuffer(file);
        }

        function formatExcelTime(timeVal) {
            if(typeof timeVal === 'string') {
                return timeVal.replace('.', ':').padStart(5, '0');
            } else if (typeof timeVal === 'number') {
                const totalSeconds = Math.round(timeVal * 86400);
                const hours = Math.floor(totalSeconds / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
            }
            return "06:30";
        }

        // --- Event Listeners ---
        document.getElementById('setBulan').addEventListener('change', (e) => { appState.periode.bulan = e.target.value; renderApp(); });
        document.getElementById('setTahun').addEventListener('input', (e) => { appState.periode.tahun = e.target.value; renderApp(); });
        document.getElementById('setMinggu').addEventListener('change', (e) => { appState.periode.minggu = e.target.value; renderApp(); });
        document.getElementById('setKepsekNama').addEventListener('input', (e) => { appState.kepsek.nama = e.target.value; renderApp(); });
        document.getElementById('setKepsekNIP').addEventListener('input', (e) => { appState.kepsek.nip = e.target.value; renderApp(); });

        document.querySelectorAll('#hariContainer input[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', () => {
                const checkedBoxes = Array.from(document.querySelectorAll('#hariContainer input[type="checkbox"]:checked'));
                appState.hariAktif = checkedBoxes.map(cb => cb.value);
                renderApp();
            });
        });

        // Inisialisasi
        renderApp();
    </script>
</body>
